{
  "name": "hawana-liquidation-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare_web_assets.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false",
    "catalog:launch": "python scripts/prepare_launch_catalog.py && python scripts/apply_excel_product_images.py && python scripts/optimize_catalog_images.py",
    "catalog:images": "python scripts/optimize_catalog_images.py",
    "catalog:hosiery-worn": "python scripts/restore_hosiery_lifestyle_images.py",
    "db:products": "python scripts/build_product_database.py",
    "assets:plan": "python scripts/kie_generate_assets.py --plan && python scripts/kie_generate_videos.py --plan",
    "assets:videos": "python scripts/kie_generate_videos.py",
    "assets:generate": "python scripts/kie_generate_videos.py"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/outfit": "^5.2.6",
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.13.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
