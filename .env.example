# Keep this value server-side. Never expose it through a VITE_ variable.
KIE_API_KEY=

# Current Kie Market models used by scripts/kie_generate_assets.py
KIE_IMAGE_MODEL=grok-imagine/image-to-image
KIE_VIDEO_MODEL=grok-imagine-video-1-5-preview
KIE_VIDEO_RESOLUTION=720p

# Google Apps Script Web App URL that appends each checkout order to a Google Sheet.
# Set up: scripts/google-sheets-orders.gs + scripts/README-orders-sheet.md
# This value is public (shipped to the browser) — that's expected for this integration.
VITE_ORDERS_SHEET_URL=

